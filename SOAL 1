#include <iostream>
using namespace std;

struct pesanan {
    string namaHewan;
    string menuPesanan;
    int urutanDatang;
    int statusVIP; //Status VIP (1 = biasa; 2 = VIP)
};

class queuePesanan {
    private :
        pesanan* data;
        int ukuran;
        int jumlah;

    public :
        queuePesanan (int ukuranAwal) {
            ukuran = ukuranAwal;
            data = new pesanan[ukuran];
            jumlah = 0;
        }

        ~queuePesanan() {
            delete[] data;
        }

        void tambahPesanan (pesanan p) {
            if (jumlah == ukuran) {
                ukuran *= 2;
                pesanan* baru = new pesanan[ukuran];
                for (int i = 0; i < jumlah; i++) {
                    baru[i] = data[i];
                }
                delete[] data;
                data = baru;
            } 
            data[jumlah++] = p;
        }

        void urutanPesanan() {
        for (int i = 0; i < jumlah - 1; i++) {
            for (int j = i + 1; j < jumlah; j++ ) { 
                if (data[j].statusVIP > data[i].statusVIP || data[j].statusVIP == data[i].statusVIP && data[j].urutanDatang < data[i].urutanDatang) {
                    swap (data[i], data[j]);
                }
            }
        }  
    }

    void tampilkanPesanan() {
        urutanPesanan();
        cout << "\n--- Daftar Pesanan Yang Dilayani ---\n";
          for (int i = 0; i < jumlah; i++) {
            cout << i + 1 << ". " << data[i].namaHewan << " - " << data[i].menuPesanan;
            if (data[i].statusVIP == 2)
                cout << "  [VIP]";
            cout << endl;
        }
    }
};

int main() {
    int n;
    cout << "Masukkan jumlah pesanan: ";
    cin >> n;
    cin.ignore();

    queuePesanan daftar(n);
    for (int i = 0; i < n; i++) {
        pesanan p;
        p.urutanDatang = i + 1;

        cout << "\nPesanan " << i + 1 << ":\n";
        cout << "Nama hewan: ";
        getline(cin, p.namaHewan);
        cout << "Menu pesanan: ";
        getline(cin, p.menuPesanan);
        cout << "Status VIP (1=biasa, 2=VIP): ";
        cin >> p.statusVIP;
        cin.ignore();

        daftar.tambahPesanan(p);
    }

    daftar.tampilkanPesanan();
    return 0;
}
