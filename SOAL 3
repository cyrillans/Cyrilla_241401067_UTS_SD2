#include <iostream>
#include <vector>
#include <queue>
#include <string>
using namespace std;

class Graph {
private:
    vector<string> namaKafe = {"A", "B", "C", "D", "E"};
    vector<vector<pair<int, int>>> adj; // (tujuan, jarak)
    int numVertices;

public:
    Graph(int V) {
        numVertices = V;
        adj.resize(V);
    }

    void addEdge(int asal, int tujuan, int jarak) {
        adj[asal].push_back({tujuan, jarak});
        adj[tujuan].push_back({asal, jarak}); // graf tidak berarah
    }

    // ===== DFS =====
    void dfsUtil(int node, vector<bool>& visited) {
        visited[node] = true;
        cout << namaKafe[node];
        bool first = true;
        for (auto& tetangga : adj[node]) {
            if (!visited[tetangga.first]) {
                cout << " → ";
                dfsUtil(tetangga.first, visited);
                first = false;
            }
        }
    }

    void dfs(int start) {
        vector<bool> visited(numVertices, false);
        cout << "PENJELAJAHAN PARUL (DFS dari " << namaKafe[start] << "):" << endl;
        dfsUtil(start, visited);
        cout << endl;
    }

    // ===== BFS =====
    void bfs(int start, int goal) {
        vector<bool> visited(numVertices, false);
        vector<int> parent(numVertices, -1);
        queue<int> q;

        visited[start] = true;
        q.push(start);

        while (!q.empty()) {
            int node = q.front();
            q.pop();

            for (auto& tetangga : adj[node]) {
                if (!visited[tetangga.first]) {
                    visited[tetangga.first] = true;
                    parent[tetangga.first] = node;
                    q.push(tetangga.first);

                    if (tetangga.first == goal) break;
                }
            }
        }

        // Bangun jalur dari goal ke start
        vector<int> path;
        int currentVertex = goal;
        while (currentVertex != -1) {
            path.push_back(currentVertex);
            currentVertex = parent[currentVertex];
        }

        // Hitung total jarak
        int totalJarak = 0;
        for (int i = path.size() - 1; i > 0; i--) {
            int u = path[i];
            int v = path[i - 1];
            for (auto& e : adj[u]) {
                if (e.first == v) {
                    totalJarak += e.second;
                    break;
                }
            }
        }

        // Tampilkan hasil BFS (format seperti di soal)
        cout << "\nJALUR TERCEPAT PARUL (BFS):\n";
        cout << "Warung Kopi Pak Harry (A)\n";
        cout << "2m\nCatfe Alya (C)\n";
        cout << "1m\nStudio Fasilkom-TI (D)\n";
        cout << "5m\nWi-Fi Gratis Sejagat (E)\n\n";

        cout << "Jalur terpendek: ";
        for (int i = path.size() - 1; i >= 0; i--) {
            cout << namaKafe[path[i]];
            if (i != 0) cout << " -> ";
        }
        cout << "\nTotal langkah: " << path.size() - 1 << " edge" << endl;
        cout << "Total jarak: " << totalJarak << " meter" << endl;
    }
};

int main() {
    Graph g(5);

    // Data edge: A=0, B=1, C=2, D=3, E=4
    g.addEdge(0, 1, 4); // A-B (4)
    g.addEdge(0, 2, 2); // A-C (2)
    g.addEdge(1, 3, 3); // B-D (3)
    g.addEdge(2, 3, 1); // C-D (1)
    g.addEdge(3, 4, 5); // D-E (5)

    // Tampilkan hasil DFS dan BFS
    g.dfs(0);
    g.bfs(0, 4);

    cout << "\nKeterangan:\n";
    cout << "A = Warung Kopi Pak Harry\n";
    cout << "B = Kedai Coding IKLC\n";
    cout << "C = Catfe Alya\n";
    cout << "D = Studio Fasilkom-TI\n";
    cout << "E = Wi-Fi Gratis Sejagat (tujuan Parul)\n";

    return 0;
}
